<?xml version="1.0" encoding="UTF-8"?>
<!--suppress ALL -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.strad</groupId>
    <artifactId>mc-tas-lang</artifactId>
    <version>0.1</version>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <pluginRepositories>
        <pluginRepository>
            <id>bytecode.space</id>
            <url>https://repo.bytecode.space/repository/maven-public/</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <!-- Filter only plugin.yml so ${project.version} (and other pom props) are substituted at build
             time - this pom is the single source of truth for the version. Other resources copied as-is. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>plugin.yml</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>plugin.yml</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Surface plain @Deprecated usages (hidden by default) so deprecation cleanup is complete. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- 3.13.0's incremental staleness check NPEs ("this.hashes is null") on this setup; disable it. -->
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <compilerArgs>
                        <arg>-Xlint:deprecation</arg>
                        <!-- src/lint/java (compiled by antrun's compile-lint): warns on two at(n) for one tick in a method, bad or repeated head angles; errors on input after clickGui on its tick. -->
                        <arg>-processorpath</arg>
                        <arg>${project.build.directory}/lint-classes</arg>
                        <arg>-processor</arg>
                        <arg>lint.DuplicateAt,lint.HeadAngles,lint.GuiStillOpen</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>ca.bkaw</groupId>
                <artifactId>paper-nms-maven-plugin</artifactId>
                <version>1.5</version>
            </plugin>
            <!-- Tell Paper this plugin is already Mojang-mapped so it loads without remapping. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <paperweight-mappings-namespace>mojang</paperweight-mappings-namespace>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!-- Copy the freshly-built jar into the local deploy staging folder
                 (network test/assets/plugins) that deploy-remote.bat pushes from.
                 Relative path so no absolute home path is committed. Does NOT clean
                 old versions locally - that is done by hand / on the remote. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>compile-lint</id>
                        <phase>generate-sources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/lint-classes"/>
                                <javac srcdir="${project.basedir}/src/lint/java" destdir="${project.build.directory}/lint-classes"
                                       includeantruntime="false" release="25"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-jar</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${project.basedir}/../../../testing servers/network test/assets/plugins"/>
                                <!-- Local tas server: Paper swaps update/ in on next start, so building while it
                                     runs is fine (the live jar is locked on Windows). -->
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${project.basedir}/../../../testing servers/tas server/plugins/update"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>ca.bkaw</groupId>
            <artifactId>paper-nms</artifactId>
            <version>26.2.build.129-stable</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>